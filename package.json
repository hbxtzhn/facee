{
  "name": "facee",
  "version": "0.1.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "expo": "57.0.27",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "^57.0.1",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "lucide-react-native": "^1.33.0",
    "markdown-it": "^14.3.2",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-zip-archive": "^9.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@jest/globals": "^30.5.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "expo-constants": "57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:release": "node --test scripts/*.test.mjs",
    "audit:deps": "pnpm audit --prod",
    "notices": "node scripts/generate-notices.mjs",
    "check:expo": "expo install --check",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts",
      "<rootDir>/src/**/*.spec.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^punycode$": "<rootDir>/node_modules/punycode",
      "^lucide-react-native$": "<rootDir>/src/test-utils/lucide-stub.tsx"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native|react-native-markdown-display|react-native-fit-image|markdown-it|mdurl|uc.micro|linkify-it|entities|punycode|react-native-safe-area-context))"
    ]
  },
  "private": true
}
