{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hbxtzhn/facee/packages/bank-spec/schema/front-matter.schema.json",
  "title": "FaceE 题目文件 front matter（规范 v2 §2.1）",
  "description": "供编辑器提示。id 可暂缺（由 bank-spec fix-ids 补齐）；引用是否存在等跨文件规则由 bank-spec validate 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "type", "difficulty", "category", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^q_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["concept", "scenario", "coding", "design", "behavioral", "choice"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "importance": { "enum": [1, 2, 3], "default": 2 },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "tags": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
    "appliesTo": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "^q_[0-7][0-9A-HJKMNP-TV-Z]{25}$" } },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^q_[0-7][0-9A-HJKMNP-TV-Z]{25}$" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "retired": {
      "description": "已删除、永不复用的要点 / 追问 id",
      "type": "array",
      "items": { "type": "string", "pattern": "^(kp|f)[1-9][0-9]{0,2}$" }
    }
  }
}
