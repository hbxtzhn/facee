{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HBxtzhn/facee/packages/bank-spec/schema/bundle.schema.json",
  "title": "FaceE 题库 bundle.json（规范 v2 §3.2）",
  "description": "与 src/bank/types.ts 的 Bundle 一致。未列出的字段一律允许（App 忽略未知字段）。",
  "type": "object",
  "required": ["schemaVersion", "bank", "categories", "tags", "collections", "lifecycle", "questions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "bank": { "$ref": "#/$defs/BankMeta" },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/Category" } },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/Tag" } },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/Collection" } },
    "lifecycle": { "$ref": "#/$defs/Lifecycle" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/Question" } }
  },
  "$defs": {
    "BankId": { "type": "string", "pattern": "^[a-z0-9.-]+\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$" },
    "QuestionId": { "type": "string", "pattern": "^q_[0-9A-HJKMNP-TV-Z]{26}$" },
    "KeyPointId": { "type": "string", "pattern": "^kp[1-9][0-9]{0,2}$" },
    "FollowupId": { "type": "string", "pattern": "^f[1-9][0-9]{0,2}$" },
    "SlugId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "Markdown": { "type": "string", "description": "受限 Markdown：无 HTML；图片引用 asset:<sha256>.<ext>" },
    "NullableMarkdown": { "type": ["string", "null"] },
    "BankMeta": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/BankId" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 5 },
        "description": { "type": "string" },
        "locale": { "type": "string" },
        "license": { "type": "string" },
        "homepage": { "type": "string" },
        "feedbackUrl": { "type": "string" },
        "update": {
          "type": "object",
          "required": ["manifest"],
          "properties": {
            "manifest": { "type": "string" },
            "fallback": { "type": "string" }
          }
        }
      }
    },
    "Category": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/SlugId" },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "description": { "type": "string" }
      }
    },
    "Tag": {
      "type": "object",
      "required": ["id", "name", "parent"],
      "properties": {
        "id": { "$ref": "#/$defs/SlugId" },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "anyOf": [{ "$ref": "#/$defs/SlugId" }, { "type": "null" }] },
        "order": { "type": "integer" },
        "description": { "type": "string", "minLength": 1, "description": "标签范围说明（纯文本）" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "同义词，用于搜索与近义标签映射；全库唯一，不与任何标签 id / name 相同"
        }
      }
    },
    "Collection": {
      "type": "object",
      "required": ["id", "name", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/SlugId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/QuestionId" } }
      }
    },
    "Lifecycle": {
      "type": "object",
      "required": ["removed", "merged"],
      "properties": {
        "removed": { "type": "array", "items": { "$ref": "#/$defs/QuestionId" } },
        "merged": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/QuestionId" },
          "additionalProperties": { "$ref": "#/$defs/QuestionId" }
        }
      }
    },
    "KeyPoint": {
      "type": "object",
      "required": ["id", "text", "weight"],
      "properties": {
        "id": { "$ref": "#/$defs/KeyPointId" },
        "text": { "type": "string", "minLength": 1 },
        "weight": { "enum": [1, 2, 3] }
      }
    },
    "Followup": {
      "type": "object",
      "required": ["id", "q", "a"],
      "properties": {
        "id": { "$ref": "#/$defs/FollowupId" },
        "q": { "type": "string", "minLength": 1 },
        "a": { "$ref": "#/$defs/Markdown" }
      }
    },
    "Answer": {
      "type": "object",
      "required": ["summary", "keyPoints"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "keyPoints": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/KeyPoint" } },
        "detail": { "$ref": "#/$defs/NullableMarkdown" },
        "examples": { "$ref": "#/$defs/NullableMarkdown" },
        "pitfalls": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "Choice": {
      "type": "object",
      "required": ["options", "correct"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "correct": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]$" } },
        "explanation": { "$ref": "#/$defs/NullableMarkdown" }
      }
    },
    "Source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "Reference": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "Question": {
      "type": "object",
      "required": [
        "id", "title", "type", "difficulty", "importance", "categoryId", "tags",
        "prompt", "answer", "choice", "followups", "contentHash"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/QuestionId" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["concept", "scenario", "coding", "design", "behavioral", "choice"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "importance": { "enum": [1, 2, 3] },
        "categoryId": { "$ref": "#/$defs/SlugId" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/SlugId" } },
        "appliesTo": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/QuestionId" } },
        "related": { "type": "array", "items": { "$ref": "#/$defs/QuestionId" } },
        "prompt": { "$ref": "#/$defs/NullableMarkdown" },
        "answer": { "$ref": "#/$defs/Answer" },
        "choice": { "anyOf": [{ "$ref": "#/$defs/Choice" }, { "type": "null" }] },
        "followups": { "type": "array", "items": { "$ref": "#/$defs/Followup" } },
        "source": { "$ref": "#/$defs/Source" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/Reference" } },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
